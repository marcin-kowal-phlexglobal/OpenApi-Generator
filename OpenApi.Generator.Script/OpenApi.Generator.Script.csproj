<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\nupkg</PackageOutputPath>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5110;NU5111;NU5128</NoWarn>

    <PackageId>OpenApi.Generator.Script</PackageId>
    <Version>1.0.0</Version>
    <Authors>marcin-kowal-phlexglobal</Authors>
    <Description>Distributes GenerateNetSdkFromOpenApi.ps1 so it can be referenced from .NET projects via NuGet.</Description>
    <PackageTags>openapi;generator;powershell;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/marcin-kowal-phlexglobal/OpenApi-Generator</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\GenerateNetSdkFromOpenApi.ps1"
          Pack="true"
          PackagePath="contentFiles\any\any\scripts\GenerateNetSdkFromOpenApi.ps1" />
    <None Include="buildTransitive\OpenApi.Generator.Script.props"
          Pack="true"
          PackagePath="buildTransitive\OpenApi.Generator.Script.props" />
    <None Include="README.md"
          Pack="true"
          PackagePath="README.md" />
  </ItemGroup>
</Project>
